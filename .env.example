# Minecraft
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Sena
MC_AUTH=offline
MC_VERSION=

# Runtime
SENA_THINK_INTERVAL_MS=12000
SENA_REFLEX_INTERVAL_MS=250
SENA_MEMORY_PATH=./data/memory.json
SENA_VIEWER_PORT=3007
SENA_ENABLE_VISION=true
SENA_MAX_BUILD_BLOCKS=160

# NVIDIA NIM - use two different API keys
NVIDIA_LLM_API_KEY=nvapi-...
NVIDIA_VLM_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=openai/gpt-oss-20b
NVIDIA_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
